# Copy this file to .env and fill in your own values. Never commit .env or share it.

# Get a key at https://console.anthropic.com/ (this powers the reply-writing brain)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Which Claude model to use for generating replies
CLAUDE_MODEL=claude-sonnet-4-5

# Master switch: only auto-reply when this is "true".
# Flip it to "false" (or send yourself the PAUSE_KEYWORD below) whenever you're back online.
AWAY_MODE=true

# Send this exact message to yourself (from another device, e.g. WhatsApp Web on a browser)
# or to any chat, and the bot will toggle AWAY_MODE off/on for the rest of that run.
TOGGLE_KEYWORD=/awaytoggle

# Comma-separated phone numbers (with country code, no +, e.g. 2547XXXXXXXX) to NEVER auto-reply to
# (family, close friends, etc.) — leave blank to auto-reply to everyone except groups.
IGNORE_NUMBERS=

# Auto-reply in group chats too? (not recommended — keep false)
REPLY_IN_GROUPS=false

# Minimum seconds to wait before sending an auto-reply (feels more human, reduces ban risk)
MIN_REPLY_DELAY_SECONDS=8
MAX_REPLY_DELAY_SECONDS=35

# Max auto-replies the bot will send to the same chat within one hour (safety cap)
MAX_REPLIES_PER_CHAT_PER_HOUR=6
